{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/uav-gate/inference-frame-v1.schema.json",
  "title": "Canonical UAV Gate Perception Inference Frame v1",
  "type": "object",
  "required": ["frame_index", "instance_mask", "num_gate_instances", "instances", "runtime"],
  "properties": {
    "sequence_id": {"type": ["string", "null"]},
    "frame_index": {"type": "integer", "minimum": 0},
    "timestamp_s": {"type": ["number", "null"]},
    "instance_mask": {"type": "string"},
    "num_gate_instances": {"type": "integer", "minimum": 0},
    "num_mask_instances": {"type": "integer", "minimum": 0},
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mask_id", "track_id", "detection_score", "box_xyxy_px", "visible_area_px", "keypoints", "pose"],
        "properties": {
          "mask_id": {"type": ["integer", "null"], "minimum": 1},
          "source": {"enum": ["model", "memory_propagated"]},
          "track_id": {"type": ["string", "null"]},
          "detection_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "mask_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "box_xyxy_px": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
          "visible_area_px": {"type": "integer", "minimum": 0},
          "keypoints": {"type": ["object", "null"]},
          "pose": {"type": ["object", "null"]}
        }
      }
    },
    "runtime": {"type": "object"}
  }
}
